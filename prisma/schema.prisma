generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model detalhes_entrada_materia_prima {
  id_detalhe_materia_prima                                                                          Int                   @id(map: "detalhes_entrada_materia_prima_pk") @default(autoincrement())
  entrada_materia_prima                                                                             Int
  materia_prima                                                                                     Int
  quantidade                                                                                        Int
  data_devolucao_ibc                                                                                DateTime              @db.Date
  data_validade_materia_prima                                                                       Int
  entrada_materia_prima_detalhes_entrada_materia_prima_entrada_materia_primaToentrada_materia_prima entrada_materia_prima @relation("detalhes_entrada_materia_prima_entrada_materia_primaToentrada_materia_prima", fields: [entrada_materia_prima], references: [id_entrada_materia_prima], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_entrada_mp_entrada_mp_id_entrada_mp_fk")
  materias_primas                                                                                   materias_primas       @relation(fields: [materia_prima], references: [id_materia_prima], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_entrada_mp_mp_id_mp_fk")
}

model detalhes_fornecedores {
  fornecedor               Int
  dias_devolucao_ibc       Int?
  id_detalhes_fornecedores Int          @id(map: "detalhes_fornecedores_pk") @default(autoincrement())
  fornecedores             fornecedores @relation(fields: [fornecedor], references: [id_fornecedor], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_fornecedores_fornecedores_id_fornecedor_fk")
}

model detalhes_materia_prima {
  id_detalhe_materia_prima    Int             @id(map: "detalhes_materia_prima_pk") @default(autoincrement())
  data_validade_materia_prima DateTime?       @db.Date
  materia_prima               Int
  fornecedor                  Int?
  fornecedores                fornecedores?   @relation(fields: [fornecedor], references: [id_fornecedor], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_materia_prima_fornecedores_id_fornecedor_fk")
  materias_primas             materias_primas @relation(fields: [materia_prima], references: [id_materia_prima], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_materia_prima_materias_primas_id_materia_prima_fk")
}

model detalhes_ordens_compra {
  id_detalhes_ordem_compra Int             @id(map: "detalhes_ordens_compra_pk") @default(autoincrement())
  ordem_compra             Int
  materia_prima            Int
  quantidade               Int
  fornecedor               Int
  fornecedores             fornecedores    @relation(fields: [fornecedor], references: [id_fornecedor], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_ordens_compra_fornecedores_id_fornecedore_fk")
  materias_primas          materias_primas @relation(fields: [materia_prima], references: [id_materia_prima], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_ordens_compra_materias_primas_id_materia_prima_fk")
  ordens_compra            ordens_compra   @relation(fields: [ordem_compra], references: [id_ordem_compra], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_ordens_compra_ordens_compra_id_ordem_compra_fk")
}

model detalhes_ordens_producao {
  id_detalhes_ordem_producao Int             @id(map: "detalhes_ordens_producao_pk") @default(autoincrement())
  ordem_producao             Int
  user                       Int
  data_hora_inicio           DateTime        @db.Timestamp(6)
  data_hora_fim              DateTime        @db.Timestamp(6)
  min_ph_desejado            Int
  max_ph_desejado            Int?
  data_hora_aprovacao        DateTime        @db.Timestamp(6)
  data_hora_despejo          DateTime        @db.Timestamp(6)
  ordens_producao            ordens_producao @relation(fields: [ordem_producao], references: [id_ordem_producao], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_ordens_producao_ordens_producao_id_ordem_producao_fk")
  users                      users           @relation(fields: [user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "detalhes_ordens_producao_users_id_user_fk")
}

model entrada_materia_prima {
  id_entrada_materia_prima                                                                                         Int                                 @id(map: "entrada_materia_prima_pk") @default(autoincrement())
  ordem_compra                                                                                                     Int
  data_criacao                                                                                                     DateTime                            @default(now()) @db.Timestamp(6)
  status                                                                                                           Int
  user                                                                                                             Int
  referencia                                                                                                       Int                                 @unique(map: "entrada_materia_prima_pk_2")
  detalhes_entrada_materia_prima_detalhes_entrada_materia_prima_entrada_materia_primaToentrada_materia_prima       detalhes_entrada_materia_prima[]    @relation("detalhes_entrada_materia_prima_entrada_materia_primaToentrada_materia_prima")
  ordens_compra                                                                                                    ordens_compra                       @relation(fields: [ordem_compra], references: [id_ordem_compra], onDelete: NoAction, onUpdate: NoAction, map: "entrada_materia_prima_ordens_compra_id_ordem_compra_fk")
  users                                                                                                            users                               @relation(fields: [user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "entrada_materia_prima_users_id_user_fk")
  status_entrada_materia_prima                                                                                     status_entrada_materia_prima        @relation(fields: [status], references: [id_status_entrada_materia_prima], onDelete: NoAction, onUpdate: NoAction, map: "entrada_mp_status_entrada_mp_id_status_entrada_mp_fk")
  transaction_entrada_materia_prima_transaction_entrada_materia_prima_entrada_materia_primaToentrada_materia_prima transaction_entrada_materia_prima[] @relation("transaction_entrada_materia_prima_entrada_materia_primaToentrada_materia_prima")
}

model fornecedores {
  id_fornecedor          Int                      @id(map: "fornecedores_pk") @default(autoincrement())
  nome                   String                   @unique(map: "unique_fornecedores_name") @db.VarChar(45)
  detalhes_fornecedores  detalhes_fornecedores[]
  detalhes_materia_prima detalhes_materia_prima[]
  detalhes_ordens_compra detalhes_ordens_compra[]
}

model materias_primas {
  id_materia_prima               Int                              @id(map: "materias_primas_pk") @default(autoincrement())
  artigo                         String                           @unique(map: "unique_materias_primas_artigo") @db.VarChar(45)
  descricao                      String                           @db.VarChar(45)
  detalhes_entrada_materia_prima detalhes_entrada_materia_prima[]
  detalhes_materia_prima         detalhes_materia_prima[]
  detalhes_ordens_compra         detalhes_ordens_compra[]
}

model ordens_compra {
  id_ordem_compra        Int                      @id(map: "ordens_compra_pk") @default(autoincrement())
  referencia_ordem       Int                      @unique(map: "ordens_compra_pk_2")
  data_criacao           DateTime                 @default(now()) @db.Timestamp(6)
  status                 Int
  detalhes_ordens_compra detalhes_ordens_compra[]
  entrada_materia_prima  entrada_materia_prima[]
  status_ordens_compra   status_ordens_compra     @relation(fields: [status], references: [id_status_ordens_compra], onDelete: NoAction, onUpdate: NoAction, map: "ordens_compra_status_id_status_fk")
}

model ordens_producao {
  referencia                  Int                           @unique(map: "ordens_producao_pk_2")
  status                      Int
  lote_fabrico                Int
  id_ordem_producao           Int                           @id(map: "ordens_producao_pk") @default(autoincrement())
  produto                     Int                           @unique(map: "ordens_producao_pk_3")
  quantidade                  Int
  detalhes_ordens_producao    detalhes_ordens_producao[]
  produtos                    produtos                      @relation(fields: [produto], references: [id_produto], onDelete: NoAction, onUpdate: NoAction, map: "ordens_producao_produtos_id_produto_fk")
  status_ordens_producao      status_ordens_producao        @relation(fields: [status], references: [id_status_ordem_producao], onDelete: NoAction, onUpdate: NoAction, map: "ordens_producao_status_ordens_producao_id_status_ordem_producao")
  transaction_ordens_producao transaction_ordens_producao[]
}

model produtos {
  id_produto      Int              @id(map: "produtos_pk") @default(autoincrement())
  artigo          String           @unique(map: "produtos_pk_2") @db.VarChar(45)
  descricao       String           @db.VarChar(75)
  densidade       Decimal?         @db.Decimal(3, 2)
  ordens_producao ordens_producao?
}

model roles {
  id_role Int     @id(map: "roles_pk") @default(autoincrement())
  name    String  @unique(map: "unique_role_name_pk") @db.VarChar(45)
  users   users[]
}

model status_entrada_materia_prima {
  id_status_entrada_materia_prima   Int                                 @id(map: "status_entrada_materia_prima_pk") @default(autoincrement())
  name                              String                              @db.VarChar(45)
  entrada_materia_prima             entrada_materia_prima[]
  transaction_entrada_materia_prima transaction_entrada_materia_prima[]
}

model status_ordens_compra {
  id_status_ordens_compra Int             @id(map: "status_pk") @default(autoincrement())
  name                    String          @unique(map: "unique_status_name") @db.VarChar(45)
  ordens_compra           ordens_compra[]
}

model status_ordens_producao {
  id_status_ordem_producao    Int                           @id(map: "status_ordens_producao_pk") @default(autoincrement())
  name                        String                        @db.VarChar(45)
  ordens_producao             ordens_producao[]
  transaction_ordens_producao transaction_ordens_producao[]
}

model transaction_entrada_materia_prima {
  id_transaction_entrada_materia_prima                                                                 Int                          @id(map: "transaction_entrada_materia_prima_pk") @default(autoincrement())
  entrada_materia_prima                                                                                Int
  timestamp                                                                                            DateTime                     @default(now()) @db.Timestamp(6)
  status                                                                                               Int
  status_entrada_materia_prima                                                                         status_entrada_materia_prima @relation(fields: [status], references: [id_status_entrada_materia_prima], onDelete: NoAction, onUpdate: NoAction, map: "tran_entrada_mp_status_entrada_mp_id_status_entrada_mp_fk")
  entrada_materia_prima_transaction_entrada_materia_prima_entrada_materia_primaToentrada_materia_prima entrada_materia_prima        @relation("transaction_entrada_materia_prima_entrada_materia_primaToentrada_materia_prima", fields: [entrada_materia_prima], references: [id_entrada_materia_prima], onDelete: NoAction, onUpdate: NoAction, map: "transaction_entrada_mp_entrada_mp_id_entrada_mp_fk")
}

model transaction_ordens_producao {
  id_transaction_ordem_producao Int                    @id(map: "transaction_ordens_producao_pk") @default(autoincrement())
  timestamp                     DateTime               @default(now()) @db.Timestamp(6)
  ordem_producao                Int
  status                        Int
  ordens_producao               ordens_producao        @relation(fields: [ordem_producao], references: [id_ordem_producao], onDelete: NoAction, onUpdate: NoAction, map: "transaction_ordens_producao_ordens_producao_id_ordem_producao_f")
  status_ordens_producao        status_ordens_producao @relation(fields: [status], references: [id_status_ordem_producao], onDelete: NoAction, onUpdate: NoAction, map: "transaction_ordens_producao_status_ordens_producao_id_status_or")
}

model users {
  id_user                  Int                        @id(map: "table_name_pk") @default(autoincrement())
  user_name                String                     @unique(map: "users_pk") @db.VarChar(45)
  password                 String                     @db.VarChar(45)
  role                     Int
  data_criacao             DateTime                   @default(now()) @db.Timestamp(6)
  detalhes_ordens_producao detalhes_ordens_producao[]
  entrada_materia_prima    entrada_materia_prima[]
  roles                    roles                      @relation(fields: [role], references: [id_role], onDelete: NoAction, onUpdate: NoAction, map: "users_roles_id_role_fk")
}
